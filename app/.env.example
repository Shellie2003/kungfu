# Copiez ce fichier en app/.env et remplissez les deux valeurs.
#
# Pour essayer tout de suite, prenez plutôt .env.essai :
#     cp .env.essai .env
#
# La clé attendue est la clé PUBLIABLE (« publishable » / « anon »).
# La clé « service_role » ne doit JAMAIS figurer ici ni nulle part
# dans ce dossier : elle passe outre toutes les règles d'accès.
VITE_SUPABASE_URL=
VITE_SUPABASE_CLE=
