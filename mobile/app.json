{
  "expo": {
    "name": "Kung-fu Waishi",
    "slug": "waishi-analamahitsy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "waishi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icone.png",
    "splash": {
      "image": "./assets/demarrage.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F5132"
    },
    "android": {
      "package": "mg.analamahitsy.waishi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone-adaptative.png",
        "backgroundColor": "#0F5132"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
