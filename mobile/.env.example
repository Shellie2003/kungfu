# Les deux valeurs se lisent dans le tableau de bord Supabase du club,
# Project Settings > API. Copier ce fichier en .env — qui n'est jamais
# commité.
#
# La clé « publishable » est PUBLIQUE : elle part dans l'APK et se lit
# en quelques minutes. C'est normal. Ce qui protège les données, ce
# sont les règles d'accès de supabase/migrations/0003_securite.sql.
#
# La clé « service_role », elle, ne doit JAMAIS figurer ici ni nulle
# part dans ce dossier : elle passe outre toutes les règles.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_CLE=sb_publishable_xxxxxxxxxxxxxxxxxxxx
